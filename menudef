//----------------------------------------------------------------- main --

OptionMenu "GITDMain"
{
	// Says out loud whether corners are actually agreeing right now, and
	// what is stopping them if they are not -- see zscript/gitd_menu.zs.
	Class "GITD_MainMenu"
	Title "GlowInTheDark"
	StaticText "Four lanes: two on the walls, two on the floor", "gray"
	StaticText "and ceiling faces themselves.", "gray"
	StaticText ""
	Option "Enabled", "gitd_enabled", "OnOff"
	StaticText ""
	Option "Seamless walls", "gitd_seamless_walls", "OnOff"
	Slider "  Blend across sectors", "gitd_wall_blend", 0, 1, 0.05, 2
	StaticText "Neighbouring sectors agree across the lines", "gray"
	StaticText "they share, so colour flows instead of", "gray"
	StaticText "breaking at every step and doorway.", "gray"
	StaticText ""
	Option "Seamless corners", "gitd_seamless", "OnOff"
	Option "  Match reach and falloff too", "gitd_seamless_shape", "OnOff"
	Option "  Keep them seamless under a wave", "gitd_seamless_wave", "OnOff"
	Option "  Meet a lane the preset left off", "gitd_seamless_meet", "OnOff"
	Slider "    How much", "gitd_seamless_meet_amt", 0.05, 1.0, 0.05, 2
	StaticText "A preset that lights only the walls still", "gray"
	StaticText "touches the floor and ceiling a little, and one", "gray"
	StaticText "that lights only the flats still touches the", "gray"
	StaticText "walls. This is how much.", "gray"
	StaticText "Wall and floor agree on one colour where", "gray"
	StaticText "they touch and ramp away to their own, so", "gray"
	StaticText "the join has no edge. An explicit fade colour", "gray"
	StaticText "is kept. Matching reach and falloff makes the", "gray"
	StaticText "floor and ceiling take the wall's shape, and", "gray"
	StaticText "their own Reach and Falloff then do nothing.", "gray"
	StaticText "Corners normally give up while a wave runs,", "gray"
	StaticText "which is most of the presets. The third row", "gray"
	StaticText "keeps them agreeing anyway and beats the", "gray"
	StaticText "floor and ceiling with the walls they meet --", "gray"
	StaticText "so a preset that climbs the room (Reactor,", "gray"
	StaticText "Signal) stops climbing.", "gray"
	StaticText "Under a wave the edge still travels - that is", "gray"
	StaticText "what a wave is - but both sides now carry the", "gray"
	StaticText "same colour, brightness and grain at the join.", "gray"
	StaticText ""
	Option "Emergency lighting", "gitd_emergency", "OnOff"
	Slider "  Comes on at", "gitd_emergency_share", 0.05, 1.0, 0.05, 2
	Slider "  Brightness", "gitd_emergency_gain", 0.5, 3.0, 0.05, 2
	ColorPicker "  Colour", "gitd_emergency_color"
	StaticText "A room that has lost this share of its light", "gray"
	StaticText "fixtures glows this colour instead, brighter,", "gray"
	StaticText "so it reads as lit by something that is not", "gray"
	StaticText "the ceiling any more. Needs RS_Ballistics and", "gray"
	StaticText "its shot-out lights; without them no room ever", "gray"
	StaticText "loses a fixture and this does nothing.", "gray"
	StaticText "Lanes a preset switched off stay off.", "gray"
	StaticText ""
	Option "Fire lights the room", "gitd_firelight", "OnOff"
	Slider "  How much colour", "gitd_firelight_mix", 0.0, 1.0, 0.05, 2
	Slider "  Brightness", "gitd_firelight_gain", 0.5, 3.0, 0.05, 2
	ColorPicker "  Colour", "gitd_firelight_color"
	StaticText "A room that is burning glows warmer and", "gray"
	StaticText "brighter while it burns, and falls back as the", "gray"
	StaticText "fire dies. Needs RS_Ballistics' flamethrower;", "gray"
	StaticText "how long it takes to fade is its own setting.", "gray"

	StaticText ""
	Option "Preset", "gitd_preset", "GITD_Preset"
	Option "Texture", "gitd_texture", "GITD_Texture"
	StaticText "The surface, chosen separately from the palette.", "gray"
	StaticText "Anything but \"From the preset\" lands on top of", "gray"
	StaticText "whichever preset you picked, so the traces and the", "gray"
	StaticText "cracks are no longer stuck inside Circuitry and", "gray"
	StaticText "Spore. \"From the preset\" puts back that preset's", "gray"
	StaticText "own grain, flow and cells, and nothing else.", "gray"
	StaticText ""
	Slider "Overall speed", "gitd_speed", 0.0, 2.0, 0.05, 2
	StaticText "Scales every moving part at once -- the wave, the", "gray"
	StaticText "flow, the cells and the throb -- on top of whatever", "gray"
	StaticText "the preset chose, so a preset you like but find too", "gray"
	StaticText "busy is one slider rather than four. 1.00 is the", "gray"
	StaticText "preset as built.", "gray"
	Slider "Throb speed", "gitd_pulse_rate", 0.0, 4.0, 0.05, 2
	StaticText "How fast an alarming room beats, separately from", "gray"
	StaticText "how hard. Bright and slow was not askable for", "gray"
	StaticText "before -- the engine worked the speed out from the", "gray"
	StaticText "strength, so RedAlert strobed. 0 holds it steady.", "gray"
	StaticText ""
	Option "Shuffle preset each map", "gitd_shuffle", "OnOff"
	Option "Randomize on death", "gitd_ondeath", "GITD_OnDeath"
	StaticText "New colours re-seeds the random and texture", "gray"
	StaticText "colours. A light-keyed preset turns its hue window", "gray"
	StaticText "instead, and one with only fixed colours has none", "gray"
	StaticText "to change, so it rolls a new preset.", "gray"
	StaticText "A preset overwrites every setting below.", "gold"
	StaticText ""
	Submenu "Wall Glow  -  Floor Seam", "GITDLaneWF"
	Submenu "Wall Glow  -  Ceiling Seam", "GITDLaneWC"
	Submenu "Floor Face", "GITDLaneFG"
	Submenu "Ceiling Face", "GITDLaneCG"
	StaticText ""
	Submenu "Liquids", "GITDLiquid"
	Submenu "Colour Randomiser", "GITDRandom"
	StaticText ""
	Submenu "Wave", "GITDWave"
	Submenu "Surface Detail", "GITDDetail"
}

